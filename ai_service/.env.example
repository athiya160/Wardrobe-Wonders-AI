# Groq API Key (Get from console.groq.com)
GROQ_API_KEY=<YOUR_GROQ_API_KEY>

# Groq Model Name (e.g., llama-3.3-70b-versatile or mixtral-8x7b-32768)
MODEL_NAME=llama-3.3-70b-versatile

# Node Backend URL (used to fetch products catalog for vector indexing)
# Local: http://localhost:4000, Production: https://<your-backend-api-domain>
BACKEND_URL=http://localhost:4000

# MongoDB Connection String (Atlas Cloud URI or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dress_rental?retryWrites=true&w=majority
