# Node / Express Environment Mode (development | production)
NODE_ENV=development

# Server Port (assigned dynamically by cloud providers like Render/Cloud Run/Railway)
PORT=4000

# MongoDB Connection String (Atlas Cloud URI or Local MongoDB)
# Both MONGO_URI and MONGODB_URI are supported by backend
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dress_rental?retryWrites=true&w=majority

# JWT Secret for Authentication (Generate a long, random secret in production)
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET>

# Production Frontend Origin for CORS validation (e.g., https://wardrobe-wonders.vercel.app)
FRONTEND_URL=https://<your-frontend-domain>

# FastAPI AI Microservice URL (Local: http://127.0.0.1:8001, Production: https://<ai-service-url>)
FASTAPI_URL=http://127.0.0.1:8001

# Cloudinary Media Storage (Optional: defaults to local disk fallback /uploads if omitted)
# CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
# CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
# CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>
